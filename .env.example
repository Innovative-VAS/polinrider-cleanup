# Copy to .env and fill in. NEVER commit your real .env.
#   cp .env.example .env
#
# Docker Compose auto-loads .env for variable substitution. For direct
# `node bin/polinrider.js` runs, export these in your shell instead.

# ─── Required ──────────────────────────────────────────────────────────────────

# GitHub Personal Access Token (classic) with scopes: repo (full) + read:org.
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your GitHub organization name (e.g. mycompany).
GH_ORG=your-org-name

# ─── Recommended for a first run ─────────────────────────────────────────────────

# Pilot against specific repo(s) before scanning the whole org. Comma-separated.
# Each entry is "name" (GH_ORG is prefixed) or "owner/name". Leave empty to scan
# the entire org.
#   GH_REPO=my-first-repo
GH_REPO=

# DRY_RUN=true scans + reports the planned surgical changes but writes nothing
# and opens no PRs. Start with true; set to false only once you're satisfied.
DRY_RUN=true

# ─── Optional (sane defaults — usually leave unset) ──────────────────────────────

# Where repos are cloned (the container provides /workspace via tmpfs).
# WORKSPACE=/workspace

# Branch name prefix for the cleanup PRs.
# BRANCH_PREFIX=fix/polinrider-cleanup

# Extra hardening: freeze built-in prototypes (--frozen-intrinsics). Experimental;
# leave off unless you've confirmed it doesn't break the run.
# POLINRIDER_FROZEN=1
